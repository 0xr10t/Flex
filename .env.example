# Copy to .env and fill values locally. Do not paste secrets into chat.
# Your public wallet address (EIP-55 checksummed). The agent never needs its private key.
# Leave blank to connect MetaMask in your default browser on the first interactive flexx/setup launch.
FLEX_WALLET_ADDRESS=

# Optional provider inputs consumed by scripts/configure-rpc-providers.mjs.
# QuickNode/Chainstack keys here are management API keys, not node access tokens.
ALCHEMY_API_KEY=
QUICKNODE_API_KEY=
CHAINSTACK_API_KEY=
INFURA_API_KEY=
# PublicNode needs no key. Current verified selection: Alchemy + QuickNode + PublicNode.
# Read/broadcast RPCs may be hosted nodes, your own nodes, or compatible verified RPCs.
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# JSON arrays of full eth_simulateV1 URLs, separately configured for each chain.
# Prefer 3 independent operators with quorum 2; 2 operators with quorum 2 also works.
# A single validating node you operate is allowed only with an explicit quorum of 1.
# Local wallet URLs may use loopback HTTP. Deployed CRE needs reachable HTTPS URLs.
# All providers must support historical-block simulation, traceTransfers, state/time overrides;
# CRE providers must also support JSON-RPC batches. No particular vendor or API key is required.
SEPOLIA_SIMULATION_RPC_URLS=[]
BASE_SEPOLIA_SIMULATION_RPC_URLS=[]
ARBITRUM_SEPOLIA_SIMULATION_RPC_URLS=[]
SEPOLIA_SIMULATION_QUORUM=2
BASE_SEPOLIA_SIMULATION_QUORUM=2
ARBITRUM_SEPOLIA_SIMULATION_QUORUM=2

# flexx starts an installed Ollama at this loopback address and downloads/loads missing configured models.
# If Ollama is not on PATH, set FLEX_OLLAMA_PATH to its executable in your shell.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional recurring-payment runner started by flexx: off, dry-run, or broadcast.
# dry-run checks schedules without sending; broadcast sends only previously approved testnet plans.
# Both enabled modes require explicit direct networking, CRE login and the testnet setup below.
FLEX_CRE_MODE=off

# ENS Sepolia: override only if you have a working compatible indexer.
ENS_INDEXER_URL=https://api.v2-sepolia.ensnode.io/api/omnigraph

# CRE uses the private registry; use cre login OR an API key with workflow access.
CRE_API_KEY=
# Local `cre workflow simulate --broadcast` consumes this key directly. Test-only account; never paste it in chat.
CRE_ETH_PRIVATE_KEY=
# Public transmitter address; blank uses FLEX_WALLET_ADDRESS. Fund it with test ETH on all three chains.
CRE_TRANSMITTER_ADDRESS=
# Optional explicit transport choice shared by agent and wallet: direct or socks5h://127.0.0.1:9050.
# With Tor routing, setup and flexx start an installed Tor client automatically when its SOCKS listener is absent.
# Install Tor once (macOS: brew install tor). An existing Tor service is reused.
# Native CRE local simulation currently requires direct transport; it refuses a configured SOCKS proxy.
FLEX_SOCKS_PROXY=

# Optional autopay policy overrides; blank values use config.example.json defaults.
# A blank fee collector uses FLEX_WALLET_ADDRESS.
AUTOPAY_FEE_COLLECTOR=
AUTOPAY_FEE_USDC=
AUTOPAY_FEE_ETH=
AUTOPAY_LATE_WINDOW_SECONDS=

# Highest CCIP fee, in ETH, the wallet pays for one bridge.
CCIP_FEE_MAX_ETH=0.003

# Filled after the CRE private-registry workflow identity is available.
CRE_WORKFLOW_ID=
CRE_WORKFLOW_NAME_HEX=
CRE_WORKFLOW_OWNER=
