{
  "name": "agent-layer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "cre:build": "node scripts/cre-local.mjs build",
    "cre:simulate": "node scripts/cre-local.mjs qualify",
    "cre:run": "node scripts/cre-local.mjs run",
    "cre:watch": "node scripts/cre-local.mjs run --watch",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:acceptance": "vitest run test/acceptance",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:audit": "vitest run --config test/audit/vitest.audit.config.ts",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "pretest:scripts": "npm run build",
    "ens:check": "wallet/node_modules/.bin/vite-node scripts/ens-check.ts",
    "ens:pay": "wallet/node_modules/.bin/vite-node scripts/ens-pay.ts",
    "start": "node dist/src/index.js",
    "prebuild": "npm --prefix packages/protocol run build",
    "pretypecheck": "npm --prefix packages/protocol run build",
    "pretest": "npm --prefix packages/protocol run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "@scure/base": "2.4.0",
    "@scure/bip39": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "chrono-node": "2.10.3",
    "fastest-levenshtein": "1.0.16",
    "fastify": "5.12.8",
    "html-to-text": "10.0.1",
    "luxon": "3.7.2",
    "pdf-parse": "2.4.5",
    "pino": "10.4.0",
    "socks-proxy-agent": "8.0.5",
    "viem": "2.57.16",
    "@flex/protocol": "file:packages/protocol"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/html-to-text": "9.0.4",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "11.0.5"
    },
    "ts-json-schema-generator@2.9.0": {
      "glob": "14.0.4"
    },
    "vitest@4.1.12": {
      "vite": "7.3.7"
    }
  }
}
