{
  "calls": [
    {
      "name": "amounts",
      "match": "pay mihir 10 usdc every friday for 8 weeks",
      "output": {
        "amounts": [
          {
            "phrase": "10 usdc",
            "number": "10",
            "relative": null,
            "token": "USDC",
            "fiat": null,
            "role": "pay"
          }
        ]
      }
    },
    {
      "name": "request_type",
      "match": "mihir",
      "output": {
        "request_type": "actions",
        "actions": ["k"],
        "also_balance": false
      }
    },
    {
      "name": "spans",
      "match": "mihir",
      "output": {
        "spans": [
          {
            "text": "mihir",
            "kind": "name",
            "role": "payee"
          }
        ]
      }
    },
    {
      "name": "payments",
      "match": "ACTION KINDS:",
      "output": {
        "payments": [
          {
            "kind": "k",
            "amount": "$amount:0",
            "recipient": "$recipient:0",
            "chain": "unstated",
            "frequency": "weekly",
            "interval": 1,
            "times_per_week": null,
            "days_of_week": ["FRI"],
            "day_of_month": null
          }
        ]
      }
    }
  ]
}
